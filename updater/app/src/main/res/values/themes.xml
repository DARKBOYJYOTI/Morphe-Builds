<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MorpheBuilds" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/google_blue</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#E8F0FE</item>
        <item name="colorOnPrimaryContainer">@color/google_dark</item>
        <item name="colorSecondary">@color/google_green</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorError">@color/google_red</item>
        <item name="colorSurface">@color/google_surface</item>
        <item name="colorOnSurface">@color/google_dark</item>
        <item name="colorSurfaceVariant">@color/google_background</item>
        <item name="colorOutline">@color/google_outline_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="popupMenuStyle">@style/Widget.MorpheBuilds.PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Widget.MorpheBuilds.OverflowMenu</item>
    </style>

    <style name="Widget.MorpheBuilds.PopupMenu" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_rounded</item>
    </style>

    <style name="Widget.MorpheBuilds.OverflowMenu" parent="Widget.MaterialComponents.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/bg_popup_rounded</item>
    </style>

    <style name="Widget.MorpheBuilds.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="endIconMode">dropdown_menu</item>
    </style>

</resources>
